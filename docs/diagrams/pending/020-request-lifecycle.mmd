sequenceDiagram
    participant Client as "Client (Browser/App)"
    participant Vite as "Vite Dev Proxy"
    participant Express as "Express Server"
    participant AuthMdw as "Auth Middleware (protect)"
    participant SupabaseAuth as "Supabase Auth"
    participant UploadMdw as "Upload Middleware (Multer)"
    participant ContentCtrl as "Content Controller"
    participant ContentSvc as "Content Service"
    participant StorageSvc as "Storage Service / R2"
    participant DB as "Supabase PostgreSQL"
    participant NotifSvc as "Notification Service"

    Client->>Vite: multipart POST
    Vite->>Express: forward to Express
    Express->>Express: CORS Check
    Express->>Express: JSON Body Parser (1100mb limit)
    Express->>AuthMdw: body parsed
    AuthMdw->>AuthMdw: Extract Bearer Token
    AuthMdw->>SupabaseAuth: getUser(token)
    alt JWT valid and not expired?
        SupabaseAuth-->>AuthMdw: valid token
        AuthMdw->>AuthMdw: findUserById(authUser.id)
        AuthMdw->>AuthMdw: reshapeUserForApp / Impersonation
        AuthMdw->>AuthMdw: req.user Attached
        AuthMdw->>UploadMdw: req.user set
        UploadMdw->>UploadMdw: Multer Parse Multipart
        UploadMdw->>UploadMdw: Validate MIME Type (image/video/audio)
        alt File MIME type in allowed list?
            UploadMdw->>UploadMdw: Validate File Size (≤ 1GB)
            alt File size <= 1GB?
                UploadMdw->>ContentCtrl: files valid
                ContentCtrl->>ContentSvc: extract and guard
                loop Multiple files in upload (max 10)
                    ContentSvc->>ContentSvc: Generate UUID Filename
                    ContentSvc->>StorageSvc: upload to R2
                    alt upload succeeds
                        StorageSvc-->>ContentSvc: uploaded
                        alt Is image file?
                            ContentSvc->>ContentSvc: Image Thumbnail (sharp)
                        else
                            ContentSvc->>ContentSvc: Video Thumbnail (ffmpeg)
                        end
                        ContentSvc->>StorageSvc: Upload Thumbnail to R2
                        StorageSvc-->>ContentSvc: all files processed
                    else retries exhausted
                        StorageSvc-->>ContentSvc: upload failed
                    end
                end
                ContentSvc->>ContentSvc: Assemble File URLs
                ContentSvc->>DB: INSERT Content Record
                alt DB insert succeeds?
                    alt Is content published (not scheduled)?
                        ContentSvc->>NotifSvc: notifySubscribersOfNewContent
                        NotifSvc-->>ContentSvc: fire-and-forget
                    end
                    ContentSvc-->>ContentCtrl: return created content
                    ContentCtrl-->>Express: JSON response
                    Express-->>Vite: JSON response
                    Vite-->>Client: JSON response
                else
                    DB-->>ContentSvc: insert failed
                    ContentSvc->>StorageSvc: cleanup R2 files
                end
            else
                UploadMdw->>UploadMdw: Return 400 File too large
            end
        else
            UploadMdw->>UploadMdw: Return 400 Invalid file type
        end
    else
        SupabaseAuth-->>AuthMdw: invalid or expired
        AuthMdw-->>Express: Return 401 Unauthorized
    end
