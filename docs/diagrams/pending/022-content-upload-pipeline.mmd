sequenceDiagram
    participant Frontend as "Frontend"
    participant UploadMdw as "Upload Middleware (Multer)"
    participant ContentSvc as "Content Service"
    participant StorageSvc as "Storage Service / R2"
    participant DB as "Supabase PostgreSQL"
    participant NotifSvc as "Notification Service"

    Frontend->>UploadMdw: multipart data
    UploadMdw->>UploadMdw: Multer Parses Multipart
    UploadMdw->>UploadMdw: MIME Type Filter
    alt File MIME type allowed (image/*, video/*)?
        UploadMdw->>UploadMdw: File Size Check (≤ 1GB)
        alt File size ≤ 1GB?
            UploadMdw->>ContentSvc: valid file
            ContentSvc->>ContentSvc: contentService.createNewContent
            loop For each file in upload (max 10)
                ContentSvc->>ContentSvc: Generate UUID Path
                ContentSvc->>StorageSvc: Upload Original to R2 Private
                alt upload succeeds
                    StorageSvc-->>ContentSvc: success
                    alt Is the file an image?
                        ContentSvc->>ContentSvc: Image Thumbnail (sharp)
                        alt sharp error
                            ContentSvc->>ContentSvc: Thumbnail Fallback (original)
                        end
                    else
                        ContentSvc->>ContentSvc: Video Thumbnail (ffmpeg)
                        alt ffmpeg error
                            ContentSvc->>ContentSvc: Thumbnail Fallback (original)
                        end
                    end
                    ContentSvc->>StorageSvc: Upload Thumbnail to R2
                    StorageSvc-->>ContentSvc: all files processed
                else all retries exhausted
                    loop R2 upload retry (max 3 attempts)
                        StorageSvc->>StorageSvc: Exponential backoff retry
                    end
                    StorageSvc->>StorageSvc: Upload Failed — Cleanup Previous
                    StorageSvc-->>Frontend: 500 error
                end
            end
            ContentSvc->>ContentSvc: Assemble File URLs JSONB
            ContentSvc->>ContentSvc: Status: scheduled or published
            ContentSvc->>ContentSvc: PPV Price Validation
            alt Is visibility = pay_per_view?
                ContentSvc->>ContentSvc: Validate price > 0 else throw 400
            end
            ContentSvc->>DB: INSERT Content Record
            alt DB insert succeeds?
                DB-->>ContentSvc: success
                ContentSvc->>NotifSvc: Notify Subscribers (fire-and-forget)
                NotifSvc-->>ContentSvc: fire-and-forget
                ContentSvc->>ContentSvc: Log Analytics Event
                ContentSvc-->>Frontend: Return Created Content Record
            else DB error
                DB-->>ContentSvc: insert failed
                ContentSvc->>StorageSvc: DB Fail — Delete All R2 Files
                StorageSvc-->>Frontend: 500 error
            end
        else
            UploadMdw-->>Frontend: Return 400 File Too Large
        end
    else
        UploadMdw-->>Frontend: Return 400 Invalid MIME
    end
